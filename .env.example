# ═══════════════════════════════════════════════════════════════
# KLTN Project — Root Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── MinIO (S3-compatible object storage) ──
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme_strong_password

# ── Apache Superset ──
SUPERSET_SECRET_KEY=changeme_very_long_random_secret_key
SUPERSET_ADMIN_PASSWORD=changeme_admin_password

# ── CouchDB (Hyperledger Fabric state database) ──
COUCHDB_PASSWORD=changeme_couchdb_password
